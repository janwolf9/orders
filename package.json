{
  "name": "webapp-fullstack",
  "version": "1.0.0",
  "description": "Full-stack Node.js web application with MongoDB",
  "main": "backend/server.js",
  "scripts": {
    "build": "echo 'Build completed'",
    "start": "node backend/server.js",
    "dev": "nodemon backend/server.js",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "test:codegen": "playwright codegen http://localhost:3001"
  },
  "engines": {
    "node": ">=14.x"
  },
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^7.5.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "multer": "^1.4.5-lts.1",
    "express-rate-limit": "^6.10.0",
    "helmet": "^7.0.0",
    "morgan": "^1.10.0",
    "express-validator": "^7.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.10.0"
  },
  "keywords": [
    "nodejs",
    "express",
    "mongodb",
    "vercel",
    "rest-api",
    "authentication",
    "crud"
  ],
  "author": "Jan Wolf",
  "license": "ISC"
}